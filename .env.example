# 本文件是 .env 的模板，可提交到 git（.env 本身已被 .gitignore 忽略）。
# 使用方法：
#     cp .env.example .env
# 然后在 .env 中填入真实密钥。
# 密钥申请地址：https://cloud.siliconflow.cn/account/ak

SILICONFLOW_API_KEY=sk-REPLACE_ME

# 模型选择：工具调用能力越强，Agent 的"取数 → 写文件"编排越可靠。
# 切勿使用 Qwen/Qwen2.5-7B-Instruct：它会并行调用 get_market_overview 和
# write_file，导致报告在数据返回前就被写入，内容为空。
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash
